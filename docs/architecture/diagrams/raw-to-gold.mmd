    %% ═══════════════════════════════════════════════════
    %% RBC Enterprise Lakehouse — Raw to Gold Architecture
    %% Includes: Fabric Import Semantic Layer (ADR-010)
    %% RBC Assist via Fabric Data Agent + Azure AI Foundry
    %% Updated: 2026-04-01
    %% ═══════════════════════════════════════════════════

    subgraph SRC["SOURCES · 300+"]
        direction TB
        S1["Mainframe z/OS\nDB2 · VSAM · COBOL\nDW00 / N500"]
        S2["Op. Databases\nOracle · DB2 · MSSQL\nCDC / batch"]
        S3["Market Data\nReuters · Bloomberg\nReal-time + EOD"]
        S4["Files / APIs\nCSV · XML · JSON\nBatch extracts"]
    end

    subgraph RAW["RAW ZONE · Immutable · 7yr Retention"]
        direction TB
        R1["SFTP / Connect:Direct\nNDM post-step"]
        R2["AWS CLI\naws s3 cp · s3 sync\nBulk back-fill · SRE"]
        R3[("MinIO / S3\ns3://lakehouse-raw/\nObject Lock · FINRA")]
        R4[/"Manifest\nIngestionManifest.jsonl\nMD5 · LANDED→PROCESSED"/]
    end

    subgraph BRZ["BRONZE · Append-Only · Iceberg V2"]
        direction TB
        B1["Airflow 3.1\nDAG per source domain\n:8081 · Celery · Redis"]
        B2["Python ETL\nCobrix EBCDIC decode\n~12,000 jobs migrating"]
        B3[("Iceberg V2\nAppend-only · immutable\nbronze.source_table")]
        B4["Nessie 0.107\nBranch-per-load\n:19120 · Git history"]
        B5["Gravitino\nPII · Confidential tags\nPolicy to Ranger"]
        B6["OpenLineage\nEmitted every transform\nto Marquez :5000"]
    end

    subgraph SLV["SILVER · FSDM Conformed · Ranger ACL"]
        direction TB
        SV1["Python ETL\nFSDM conformance\nDedup · SCD · type cast"]
        SV2["Trino 479\nMandatory gateway ADR-002\n:8080 · JDBC · no Spark"]
        SV3[("Iceberg V2\nParty · Account\nTransaction · Risk")]
        SV4["Soda Core\nSodaCL quality gates\nNull pct · RI · row counts"]
        SV5["Apache Ranger\nColumn masking · RBAC\n:6080 · Solr audit"]
    end

    subgraph GLD["GOLD · Compute Plane · Authoritative"]
        direction TB
        G1["Teradata Vantage\nOTF / Iceberg engine\nAggregations · KPIs"]
        G2["Trino 479\nCross-domain joins\nADR-002 · Iceberg"]
        G3[("Iceberg V2\nStable paths · OPTIMIZE\nVACUUM on schedule")]
        G4["Cube v0.36\nNL-to-SQL · RASL ADR-006\n:15432 PostgreSQL wire"]
        G5["Ranger ACL\nAuthoritative compute ACL\nGitHub · ADR log"]
    end

    subgraph FAB["FABRIC · BI and AI Surface · ADR-010"]
        direction TB
        F1["Python ETL Copy\nGold Iceberg to Delta\nV-Order · VertiPaq"]
        F2[("Delta Tables\nOneLake Tables section\nNo XTable · No shortcuts")]
        F3[["Import Semantic Model\nVertiPaq in-memory · DAX\nRLS at semantic layer\nADR-010"]]
        F4["Prep for AI\nAI Schema · Verified QA\nImport mode only"]
        F5["Fabric Data Agent\nNL2DAX · REST endpoint\nEntra ID · user identity"]
    end

    subgraph CON["CONSUMPTION LAYER"]
        direction TB
        C1["Power BI\nVertiPaq queries\n1,000+ OBIEE reports"]
        C2["Tableau\nXMLA endpoint\nSame semantic model"]
        C3["Azure AI Foundry\nMicrosoftFabricPreviewTool\ngpt-4o orchestration"]
        C4[["RBC Assist\nAI enterprise chatbot\nEntra ID · RLS enforced"]]
        C5["AWS Bedrock\nClaude Sonnet · NL-to-SQL\nADR-009 · VPC data stays"]
    end

    subgraph GOV["GOVERNANCE · LINEAGE · OBSERVABILITY"]
        direction LR
        XG1["Gravitino\nUnified policy authoring"]
        XG2["Apache Ranger 2.8\n:6080 · Solr · ZooKeeper"]
        XL1["OpenLineage\nEvery Airflow DAG step"]
        XL2["Marquez 0.50\n:5000 REST · :3000 UI"]
        XL3["OpenMetadata 1.6\n:8585 · catalog · glossary"]
        XO1["Prometheus\n:9090 · StatsD :9102"]
        XO2["Grafana\n:3001 · BCBS 239 · SLA"]
    end

    %% ═══ MAIN PIPELINE FLOW ═══
    SRC -->|"SFTP / NDM / CDC\n300+ sources"| RAW
    RAW -->|"upload_to_raw_zone\nMD5 checksum"| BRZ
    BRZ -->|"Bronze to Silver\nFSDM conformance"| SLV
    SLV -->|"Silver to Gold\naggregation + joins"| GLD

    %% Dual-Gold split — ADR-010
    GLD -->|"Python ETL copy\nDelta · V-Order\nADR-010 dual-gold"| FAB

    %% Fabric consumption paths
    FAB -->|"VertiPaq Import mode"| C1
    FAB -->|"XMLA endpoint"| C2
    FAB -->|"NL2DAX REST endpoint"| C3
    C3 -->|"MicrosoftFabricTool"| C4

    %% NL-to-SQL via Cube path
    GLD -->|"Cube RASL · ADR-006\nNL-to-SQL schema linking"| C5

    %% Governance internal flows
    XG1 -->|"policy push"| XG2
    XL1 -->|"lineage events"| XL2
    XL2 -->|"catalog sync"| XL3
    XO1 -->|"metrics scrape"| XO2

