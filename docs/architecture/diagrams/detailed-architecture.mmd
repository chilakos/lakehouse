flowchart TD
    subgraph Storage["Storage Layer"]
        direction LR
        postgres[PostgreSQL]
        minio[MinIO S3]
    end

    subgraph Catalog["Catalog"]
        nessie[Nessie REST Catalog]
    end

    subgraph QueryEngines["Query Engines"]
        trino[Trino]
    end

    subgraph ETL["ETL / Orchestration"]
        direction LR
        airflow-ws[Airflow Webserver]
        airflow-sched[Airflow Scheduler]
        airflow-worker[Airflow Worker]
        airflow-db[Airflow DB]
        redis[Redis]
    end

    subgraph SemanticLayer["Semantic Layer"]
        direction LR
        cube-api[Cube API]
        cubestore[Cubestore]
    end

    subgraph GovernanceLineage["Governance & Lineage"]
        direction LR
        marquez[Marquez]
        marquez-db[Marquez DB]
        marquez-web[Marquez Web]
        om-server[OpenMetadata Server]
        om-ingestion[OpenMetadata Ingestion]
        om-db[OM DB]
        elasticsearch[Elasticsearch]
    end

    subgraph SecurityLayer["Security"]
        direction LR
        ranger-admin[Ranger Admin]
        ranger-db[Ranger DB]
        ranger-solr[Ranger Solr]
        ranger-zk[Ranger ZK]
        audit-receiver[Audit Receiver]
    end

    subgraph Monitoring["Monitoring"]
        direction LR
        grafana[Grafana]
        grafana-reporter[Grafana Reporter]
        prometheus[Prometheus]
        statsd-exporter[StatsD Exporter]
    end

    %% Core data path
    postgres --> nessie
    minio --> nessie
    nessie --> trino
    trino --> cube-api
    cubestore --> cube-api

    %% ETL dependencies
    airflow-db --> airflow-ws
    airflow-db --> airflow-sched
    airflow-db --> airflow-worker
    redis --> airflow-ws
    redis --> airflow-sched
    redis --> airflow-worker

    %% Governance dependencies
    marquez-db --> marquez
    marquez --> marquez-web
    om-db --> om-server
    elasticsearch --> om-server
    om-server --> om-ingestion

    %% Security dependencies
    ranger-zk --> ranger-solr
    ranger-zk --> ranger-admin
    ranger-db --> ranger-admin

    %% Monitoring dependencies
    statsd-exporter --> prometheus
    prometheus --> grafana
    grafana --> grafana-reporter

