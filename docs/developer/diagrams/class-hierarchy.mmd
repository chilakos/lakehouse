classDiagram
    class BasePipeline {
        <<abstract>>
        +spark: SparkSession
        +config: PipelineConfig
        +extract() DataFrame
        +transform(df: DataFrame) DataFrame
        +validate_schema(df: DataFrame) bool
        +add_metadata_columns(df, source_system, batch_id) DataFrame
        +write(df: DataFrame)
        +run_quality_checks(df: DataFrame) dict
        +execute() dict
    }
    class PipelineConfig {
        <<frozen dataclass>>
        +name: str
        +target_layer: MedallionLayer
        +target_table: str
        +target_schema: StructType
        +source_layer: MedallionLayer | None
        +quality_checks_path: str
        +critical_checks: list[str]
        +max_retries: int
        +retry_delay_seconds: int
        +full_table_name() str
        +source_table_name() str | None
    }
    class MedallionLayer {
        <<enum>>
        BRONZE
        SILVER
        GOLD
    }
    class SchemaValidationError {
        <<exception>>
    }
    class QualityGateError {
        <<exception>>
    }
    class IncrementalConfig {
        <<dataclass>>
        +watermark_column: str
        +watermark_table: str
    }
