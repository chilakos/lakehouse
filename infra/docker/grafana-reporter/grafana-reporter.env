# Grafana Reporter configuration
# Service URL: http://grafana-reporter:8686
# Used by dag_anomaly_report.py to export BCBS 239 compliance dashboard to PDF
#
# Usage example:
#   curl "http://localhost:8686/render?dashboard=bcbs239-compliance&from=now-24h&to=now"
#   --output bcbs239_compliance_$(date +%Y%m%d).pdf
#
# Airflow DAG: governance_anomaly_report > export_compliance_pdf task
# Output: /opt/airflow/reports/bcbs239_{date}.pdf

# Grafana connection
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin

# Report settings
# Report title prefix for PDF exports
REPORT_TITLE_PREFIX=Lakehouse

# Default time range for scheduled exports (daily)
DEFAULT_TIME_FROM=now-24h
DEFAULT_TIME_TO=now

# PDF generation settings
PDF_ORIENTATION=landscape
PDF_LAYOUT=simple
